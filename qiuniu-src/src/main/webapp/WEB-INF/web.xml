<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>囚牛 - QiuNiu Prompt Management System</display-name>
    
    <description>
        基于 Tomcat 的提示词管理系统
        功能：用户注册登录、提示词 CRUD 管理
    </description>

    <!-- 欢迎页面 -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- 认证过滤器 (TEMPORARILY DISABLED FOR DEBUGGING) -->

    <!-- 会话超时配置 (30 分钟) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- 错误页面配置 -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>

    <!-- 字符编码过滤器（兼容 Jetty 和 Tomcat） -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.qiuniu.filter.EncodingFilter</filter-class>
    </filter>
    
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 初始化数据库表 (可选，首次部署时启用) -->
    <listener>
        <listener-class>com.qiuniu.listener.InitListener</listener-class>
    </listener>

</web-app>
