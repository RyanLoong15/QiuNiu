}

function editEntry(id) {
    const e = kbData.find(x => x.id === id);
    if (!e) return;
    openModal(id);
    document.getElementById('fQuestion').value = e.question;
    document.getElementById('fAnswer').value = e.answer;
    document.getElementById('fCategory').value = e.category || '';
}

function closeModal() {
    document.getElementById('modalOverlay').classList.remove('show');
}

async function submitEntry() {
    const id = document.getElementById('editId').value;
    const question = document.getElementById('fQuestion').value.trim();
    const answer = document.getElementById('fAnswer').value.trim();
    const category = document.getElementById('fCategory').value.trim() || '通用';

    if (!question || !answer) { alert('请填写问题和回答'); return; }

    const body = new URLSearchParams({ question, answer, category });
    const url = id ? KB_API + '/update' + '?id=' + id : KB_API + '/add';

    try {
        const resp = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
            credentials: 'same-origin'
        });
        if (resp.ok) {
            closeModal();
            loadKB();
        } else {
            const data = await resp.json();
            alert('保存失败: ' + (data.error || '未知错误'));
        }
    } catch(e) { alert('保存失败: ' + e.message); }
}

async function deleteEntry(id) {
    if (!confirm('确定删除该知识条目？')) return;
    try {
        await fetch(KB_API + '/delete?id=' + id, {
            method: 'POST',
            credentials: 'same-origin'
        });
        loadKB();
    } catch(e) { alert('删除失败: ' + e.message); }
}

