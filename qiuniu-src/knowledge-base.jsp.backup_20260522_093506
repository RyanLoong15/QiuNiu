<script>
const API = 'http://localhost:5001/api';
const KB_API = '${pageContext.request.contextPath}/api/knowledge-base';
const CAN_WRITE = <%= canWrite %>;
const IS_ADMIN = <%= isAdmin %>;
let kbData = [];
let currentFilter = '';
let isSending = false;
let canWrite = CAN_WRITE;

const avatarFallback = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#667eea"/><text x="20" y="26" text-anchor="middle" fill="white" font-size="18">🐉</text></svg>');

// ===== Character State =====
let characters = [];
let currentCharacterId = parseInt(localStorage.getItem('selectedCharacterId')) || null;
let currentCharacter = null;

// Load characters from API
async function loadCharacters() {
    try {
        const resp = await fetch(API + '/characters', { credentials: 'same-origin' });
        characters = await resp.json();
        renderCharacterSelector();
        // Select saved character or default to first
        if (!characters.find(c => c.id === currentCharacterId)) {
            currentCharacterId = characters.length > 0 ? characters[0].id : null;
        }
        selectCharacter(currentCharacterId, false);
    } catch(e) {
        console.error('Failed to load characters:', e);
        currentCharacter = null;
        currentCharacterId = null;
        console.warn('角色列表加载失败，使用默认角色');
    }
}

function renderCharacterSelector() {
    const container = document.getElementById('characterSelector');
    if (!container || characters.length === 0) return;

    container.innerHTML = characters.map(c => {
        const avatarSrc = c.avatar && !c.avatar.startsWith('http') && !c.avatar.startsWith('data:')
            ? '${pageContext.request.contextPath}' + c.avatar
            : (c.avatar || '${pageContext.request.contextPath}/images/avatar/avatar_base.jpg');
        const activeClass = c.id === currentCharacterId ? ' active' : '';
        return '<div class="character-card' + activeClass + '" data-id="' + c.id + '" onclick="selectCharacter(' + c.id + ')">' +
            '<img src="' + avatarSrc + '" class="char-avatar" onerror="this.src=avatarFallback">' +
            '<div class="char-info">' +
                '<span class="char-name">' + jsEscape(c.name) + '</span>' +
                '<span class="char-title">' + jsEscape(c.title || '') + '</span>' +
            '</div>' +
        '</div>';
    }).join('');
}

function selectCharacter(id, clearChatFlag) {
    const char = characters.find(c => c.id === id);
    if (!char) return;

    currentCharacterId = id;
    currentCharacter = char;
    localStorage.setItem('selectedCharacterId', id);

    // Update selector UI
    document.querySelectorAll('.character-card').forEach(el => {
        el.classList.toggle('active', parseInt(el.dataset.id) === id);
    });

    // Update bot name in header
    const botName = document.querySelector('.bot-info .bot-name');
    if (botName) botName.textContent = char.name + ' AI 助手';

    // Update bot status
    const botStatus = document.querySelector('.bot-info .bot-status');
    if (botStatus) botStatus.textContent = char.title || '基于知识库回答';

    // Update header avatar
    const headerAvatar = document.querySelector('.chat-header .bot-avatar');
    if (headerAvatar) {
        const avatarSrc = char.avatar && !char.avatar.startsWith('http') && !char.avatar.startsWith('data:')
            ? '${pageContext.request.contextPath}' + char.avatar
            : '${pageContext.request.contextPath}/images/avatar/avatar_base.jpg';
        headerAvatar.src = avatarSrc;
        headerAvatar.onerror = function() { this.src = avatarFallback; };
    }

    // Clear chat on character switch (avoid context confusion)
    if (clearChatFlag !== false) {
        clearChatSilent();
        const container = document.getElementById('chatMessages');
        container.innerHTML = '';
        appendMsg('bot', '👋 你好！我是' + jsEscape(char.name) + '，' + (char.description || '可以基于知识库回答你的问题') + '。有什么想了解的？');
    }
}

function clearChatSilent() {
    fetch(API + '/clear', { method: 'POST', credentials: 'same-origin' }).catch(function(){});
}

function getBotAvatar() {
    return '${pageContext.request.contextPath}/images/avatar/avatar_base.jpg?t=' + Date.now();
}

// Load knowledge base list
async function loadKB() {
    try {
        const r = await fetch(KB_API + '/list', { credentials: 'same-origin' });
        const data = await r.json();
        kbData = data.entries || [];
        renderKB();
        renderFilters();
    } catch(e) { console.error('KB load error', e); }
}

// Build bot avatar URL with timestamp to bust cache
function botAvatarUrl() {
    return '${pageContext.request.contextPath}/images/avatar/avatar_base.jpg?t=' + Date.now();
}

function renderKB() {
    const list = document.getElementById('kbList');
    const filtered = currentFilter ? kbData.filter(e => e.category === currentFilter) : kbData;
    if (filtered.length === 0) {
        list.innerHTML = '<div style="text-align:center;padding:40px 0;color:#ccc;font-size:14px">暂无知识条目</div>';
        return;
    }
    list.innerHTML = filtered.map(e => {
        const q = jsEscape(e.question.split('|')[0]);
        const a = jsEscape(e.answer);
        const c = jsEscape(e.category || '通用');
        const cls = (e.enabled ? '' : ' disabled');
        return '<div class="kb-item ' + cls + '" onclick="askQuestion(\'' + q + '\')">' +
            '<div class="kb-item-top">' +
                '<span class="kb-item-q">' + q + '</span>' +
                '<span class="kb-item-cat">' + c + '</span>' +
            '</div>' +
            '<div class="kb-item-a">' + a + '</div>' +
            (canWrite ? '<div class="kb-item-actions">' +
                '<button class="btn-kb-edit" onclick="event.stopPropagation();editEntry(' + e.id + ')">编辑</button>' +
                '<button class="btn-kb-del" onclick="event.stopPropagation();deleteEntry(' + e.id + ')">删除</button>' +
            '</div>' : '') +
        '</div>';
    }).join('');
}

function renderFilters() {
    const cats = [...new Set(kbData.map(e => e.category).filter(Boolean))];
    const filters = document.getElementById('kbFilters');
    filters.innerHTML = '<span class="filter-tag' + (currentFilter===''?' active':'') + '" data-cat="" onclick="setFilter(\'\')">全部</span>' +
        cats.map(c => '<span class="filter-tag' + (currentFilter===c?' active':'') + '" data-cat="' + jsEscape(c) + '" onclick="setFilter(\'' + jsEscape(c) + '\')">' + jsEscape(c) + '</span>').join('');
}

function setFilter(cat) {
    currentFilter = cat;
    renderKB();
    renderFilters();
}

function htmlEscape(s) {
    if (!s) return '';
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function jsEscape(s) {
    if (!s) return '';
    return s.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r');
}

function linkifyForBot(text) {
    text = htmlEscape(text);
    const urlPattern = /(https?:\/\/[^\s<]+)/g;
    return text.replace(urlPattern, '<a href="$1" target="_blank" style="color:#667eea">$1</a>').replace(/\n/g, '<br>');
}

// Click a KB item to ask about it
function askQuestion(q) {
    document.getElementById('chatInput').value = q;
    sendMessage();
}

// ===== Chat =====

function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
}

async function sendMessage() {
    // 检查是否已选择角色
    if (!currentCharacterId) {
        alert('请先选择一个角色');
        return;
    }
    const input = document.getElementById('chatInput');
    const msg = input.value.trim();
    if (!msg || isSending) return;

    input.value = '';
    isSending = true;
    document.getElementById('btnSend').disabled = true;

    // Append user message
    appendMsg('user', msg);

    // Append typing indicator & set avatar thinking
    setAvatarMood('thinking');
    const typingId = 'typing-' + Date.now();
    appendMsg('typing', '', typingId);

    try {
        const resp = await fetch(API + '/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: msg, character_id: currentCharacterId }),
            credentials: 'same-origin'
        });
        const data = await resp.json();
        removeMsg(typingId);
        if (data.error) {
            appendMsg('bot', '❌ ' + data.error);
            setAvatarMood('default');
    } else {
        appendMsg('bot', data.answer || '（无回复）');
        setAvatarMood('happy');
        setTimeout(function() { setAvatarMood('default'); }, 2000);
    }
    } catch(e) {
        removeMsg(typingId);
        appendMsg('bot', '❌ 网络错误，请检查网络连接');
        setAvatarMood('default');
    } finally {
        isSending = false;
        document.getElementById('btnSend').disabled = false;
    }
}

function appendMsg(role, text, id) {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    const isBot = role !== 'user';
    div.className = 'msg' + (role === 'typing' ? ' typing' : (isBot ? '' : ' user'));
    if (id) div.id = id;

    if (role === 'typing') {
        // 思考中：显示 thinking 叠加层
        div.innerHTML = `
            <div class="chat-avatar-container" style="position:relative;width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;background:transparent;">
                <img src="${pageContext.request.contextPath}/images/avatar/avatar_base.jpg" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                <img class="mood-overlay thinking active" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_thinking.svg" style="position:absolute;top:0;left:0;width:100%;height:100%;">
                <img class="mood-overlay happy" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_happy.svg" style="position:absolute;top:0;left:0;width:100%;height:100%;display:none;">
                <img class="mood-overlay neutral" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_neutral.svg" style="position:absolute;top:0;left:0;width:100%;height:100%;display:none;">
            </div>
            <div class="msg-content">正在思考...</div>`;
    } else if (role === 'user') {
        div.innerHTML = `
            <img src="${pageContext.request.contextPath}/user-avatar.jsp" class="msg-avatar" alt="you"
                 onerror="this.src='data:image/svg+xml,${'$'}{encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#764ba2"/><text x="20" y="26" text-anchor="middle" fill="white" font-size="16">👤</text></svg>')}'">
            <div class="msg-content">${'$'}{linkifyUser(text)}</div>`;
    } else {
        // bot 消息：默认不激活任何叠加层，等待 setAvatarMood 更新
        div.innerHTML = `
            <div class="chat-avatar-container" style="position:relative;width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;background:transparent;">
                <img src="${pageContext.request.contextPath}/images/avatar/avatar_base.jpg" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                <img class="mood-overlay thinking" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_thinking.svg" style="position:absolute;top:0;left:0;width:100%;height:100%;display:none;">
                <img class="mood-overlay happy" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_happy.svg" style="position:absolute;top:0;left:0;width:100%;height:100%;display:none;">
                <img class="mood-overlay neutral" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_neutral.svg" style="position:absolute;top:0;left:0;width:100%;height:100%;display:none;">
            </div>
            <div class="msg-content">${'$'}{linkifyForBot(text)}</div>`;
    }
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

function removeMsg(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
}

function linkifyUser(text) {
    text = jsEscape(text);
    const urlPattern = /(https?:\/\/[^\s<]+)/g;
    return text.replace(urlPattern, '<a href="$1" target="_blank" style="color:#667eea">$1</a>');
}

// ===== KB CRUD =====

function openModal(id) {
    document.getElementById('modalOverlay').classList.add('show');
    document.getElementById('editId').value = id || '';
    document.getElementById('modalTitle').textContent = id ? '编辑知识条目' : '新增知识条目';
    if (!id) {
        document.getElementById('fQuestion').value = '';
        document.getElementById('fAnswer').value = '';
        document.getElementById('fCategory').value = '';
