let importMode = 'json';

function openImportModal() {
    document.getElementById('importModalOverlay').classList.add('show');
    document.getElementById('importJson').value = '';
    document.getElementById('importFile').value = '';
    setImportMode('json');
}

function closeImportModal() {
    document.getElementById('importModalOverlay').classList.remove('show');
}

function setImportMode(mode) {
    importMode = mode;
    document.getElementById('tabJson').classList.toggle('active', mode === 'json');
    document.getElementById('tabFile').classList.toggle('active', mode === 'file');
    document.getElementById('importJsonArea').style.display = mode === 'json' ? 'block' : 'none';
    document.getElementById('importFileArea').style.display = mode === 'file' ? 'block' : 'none';
}

async function doImport() {
    const category = document.getElementById('importCategory').value.trim() || '导入文档';
    if (importMode === 'json') {
        const jsonText = document.getElementById('importJson').value.trim();
        if (!jsonText) { alert('请输入 JSON 内容'); return; }
        try {
            const resp = await fetch(KB_API + '/import', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: jsonText,
                credentials: 'same-origin'
            });
            const data = await resp.json();
            if (data.ok) {
                alert('成功导入 ' + (data.imported || 0) + ' 条'); closeImportModal(); loadKB();
            } else {
                alert('导入失败: ' + (data.error || '未知错误'));
            }
        } catch(e) { alert('导入失败: ' + e.message); }
    } else {
        const files = document.getElementById('importFile').files;
        if (!files || files.length === 0) { alert('请选择文件'); return; }
        const formData = new FormData();
        for (const f of files) formData.append('file', f);
        formData.append('category', category);
        try {
            const resp = await fetch(KB_API + '/import', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            });
            const data = await resp.json();
            if (data.ok) {
                alert('成功导入 ' + (data.imported || 0) + ' 条\n' + (data.errors || '')); closeImportModal(); loadKB();
            } else {
                alert('导入失败: ' + (data.error || '未知错误'));
            }
        } catch(e) { alert('导入失败: ' + e.message); }
    }
}


