        <div class="field" style="margin-top:12px;">
            <label>关联虚拟人物（可选）</label>
            <select id="docCharacterId" style="width:100%;padding:8px 12px;border:1.5px solid #e0e4f0;border-radius:8px;font-size:13px;">
                <option value="">不关联</option>
            </select>
        </div>
        <div class="field" style="margin-top:12px;">
            <label style="display:flex;align-items:center;cursor:pointer;">
                <input type="checkbox" id="docPublishToKb" style="width:auto;margin-right:8px;">
                <span style="font-weight:normal;font-size:13px;color:#555;">同步到公共知识库</span>
            </label>
        </div>
        <div class="progress-wrap" id="docProgressWrap" style="display:none;">
            <div class="progress-bar"><div class="progress-fill" id="docProgressFill"></div></div>
            <div class="progress-text" id="docProgressText">准备中...</div>
        </div>
        <div class="preview-area" id="docPreviewArea"></div>
        <div class="actions">
            <button class="btn-cancel" onclick="closeDocImportModal()">取消</button>
            <button class="btn-submit" id="btnDocImport" onclick="startDocImport()">开始导入</button>
        </div>
    </div>
</div>

    <script>
    // ===== Document Import Modal =====
    let docSelectedFiles = [];

    function openDocImportModal() {
        document.getElementById('docImportModal').classList.add('show');
        document.getElementById('docFileList').innerHTML = '';
        document.getElementById('docProgressWrap').style.display = 'none';
        document.getElementById('docPreviewArea').style.display = 'none';
        document.getElementById('docPreviewArea').innerHTML = '';
        docSelectedFiles = [];
        loadCharactersForDoc();
    }

    function closeDocImportModal() {
        document.getElementById('docImportModal').classList.remove('show');
    }

    function loadCharactersForDoc() {
        fetch(API + '/characters', { credentials: 'same-origin' })
            .then(r => r.json())
            .then(data => {
                const sel = document.getElementById('docCharacterId');
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.name + (c.title ? '（' + c.title + '）' : '');
                    sel.appendChild(opt);
                });
            })
            .catch(() => {});
    }

    // Upload area click & drag
    const docUploadArea = document.getElementById('docUploadArea');
    const docFileInput = document.getElementById('docFileInput');
    docUploadArea.addEventListener('click', () => docFileInput.click());
    docUploadArea.addEventListener('dragover', e => { e.preventDefault(); docUploadArea.classList.add('dragover'); });
    docUploadArea.addEventListener('dragleave', () => docUploadArea.classList.remove('dragover'));
    docUploadArea.addEventListener('drop', e => {
        e.preventDefault();
        docUploadArea.classList.remove('dragover');
        handleDocFiles(e.dataTransfer.files);
    });
    docFileInput.addEventListener('change', e => handleDocFiles(e.target.files));

    function handleDocFiles(files) {
        for (const f of files) {
            if (![ '.docx','.pdf','.txt','.md' ].some(ext => f.name.toLowerCase().endsWith(ext))) {
                alert('不支持的文件类型：' + f.name);
                continue;
            }
            docSelectedFiles.push(f);
        }
        renderDocFileList();
    }

    function renderDocFileList() {
        const container = document.getElementById('docFileList');
        container.innerHTML = '';
        docSelectedFiles.forEach((f, i) => {
            const div = document.createElement('div');
            div.className = 'file-item';
            div.innerHTML = '<span class="file-name">' + f.name + '</span>'
                + '<span class="file-size">(' + (f.size/1024).toFixed(1) + ' KB)</span>'
                + '<span class="file-remove" onclick="removeDocFile(' + i + ')">✕</span>';
            container.appendChild(div);
        });
    }

    function removeDocFile(index) {
        docSelectedFiles.splice(index, 1);
        renderDocFileList();
    }

    function startDocImport() {
        if (docSelectedFiles.length === 0) { alert('请先选择文件'); return; }
        document.getElementById('docProgressWrap').style.display = 'block';
        document.getElementById('btnDocImport').disabled = true;
        uploadDocFiles();
    }

    function uploadDocFiles() {
        const fd = new FormData();
        docSelectedFiles.forEach(f => fd.append('files', f));
        const charId = document.getElementById('docCharacterId').value;
        if (charId) fd.append('character_id', charId);
        
        const publishToKb = document.getElementById('docPublishToKb').checked;
        if (publishToKb) fd.append('publish_to_kb', 'true');

        const xhr = new XMLHttpRequest();
        xhr.upload.addEventListener('progress', e => {
            if (e.lengthComputable) {
                const pct = Math.round(e.loaded / e.total * 100);
                document.getElementById('docProgressFill').style.width = pct + '%';
                document.getElementById('docProgressText').textContent = '上传中 ' + pct + '%';
            }
        });
        xhr.addEventListener('load', () => {
            if (xhr.status === 200) {
                const resp = JSON.parse(xhr.responseText);
                document.getElementById('docProgressFill').style.width = '100%';
                document.getElementById('docProgressText').textContent = '导入成功！';
                if (resp.chunks && resp.chunks.length > 0) {
                    showDocPreview(resp.chunks);
                }
                setTimeout(closeDocImportModal, 1500);
            } else {
                document.getElementById('docProgressText').textContent = '导入失败：' + xhr.responseText;
            }
            document.getElementById('btnDocImport').disabled = false;
        });
        xhr.addEventListener('error', () => {
            document.getElementById('docProgressText').textContent = '网络错误，请重试';
            document.getElementById('btnDocImport').disabled = false;
        });
        xhr.open('POST', '${pageContext.request.contextPath}/api/document/import');
        xhr.send(fd);
    }

    function showDocPreview(chunks) {
        const area = document.getElementById('docPreviewArea');
        area.style.display = 'block';
        area.innerHTML = '<div style="font-size:13px;font-weight:600;margin-bottom:8px;">分块预览（' + chunks.length + ' 块）</div>';
        chunks.forEach((c, i) => {
            const div = document.createElement('div');
            div.className = 'preview-item';
            div.textContent = (i+1) + '. ' + c.substring(0, 120) + (c.length > 120 ? '...' : '');
            area.appendChild(div);
        });
    }
    </script>

</body>
</html>
