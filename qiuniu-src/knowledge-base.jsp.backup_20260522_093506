<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.qiuniu.model.User" %>
<%@ page import="com.qiuniu.dao.KnowledgeBaseDAO" %>
<%@ page import="com.qiuniu.model.KnowledgeEntry" %>
<%@ page import="com.qiuniu.model.Role" %>
<%@ page import="java.util.List" %>
<%
    User user = (User) session.getAttribute("user");
    if (user == null) {
        response.sendRedirect(request.getContextPath() + "/login.jsp");
        return;
    }
    List<KnowledgeEntry> entries = null;
    List<String> categories = null;
    try {
        entries = KnowledgeBaseDAO.getAll();
        categories = KnowledgeBaseDAO.getCategories();
    } catch (Exception e) {
        e.printStackTrace();
    }
    boolean isAdmin = "ADMIN".equals(user.getRole().getCode());
    boolean canWrite = user.getRole() == Role.ADMIN || user.getRole() == Role.TEAM_ADMIN;
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>囚牛 · 知识库</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: '"Microsoft YaHei"', Arial, sans-serif;
            background: #f0f2f8;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== Header ===== */
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        }
        .header h1 { font-size: 20px; }
        .header .right { display: flex; align-items: center; gap: 12px; }
        .header a { color: rgba(255,255,255,0.85); text-decoration: none; font-size: 14px; }
        .header a:hover { color: white; }
        .header .divider { opacity: 0.4; }

        /* ===== Main layout ===== */
        .main {
            display: flex;
            flex: 1;
            overflow: hidden;
            gap: 0;
        }

        /* ===== Left: Chat Panel ===== */
        .chat-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #e0e4f0;
            min-width: 0;
        }
        .chat-header {
            padding: 14px 20px;
            background: white;
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .chat-header .bot-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #667eea;
        }
        .chat-header .bot-info .bot-name { font-size: 15px; font-weight: 600; color: #333; }
        .chat-header .bot-info .bot-status { font-size: 12px; color: #52c41a; }
        .chat-header .bot-info .bot-status::before {
            content: '';
            display: inline-block;
            width: 7px; height: 7px;
            background: #52c41a;
            border-radius: 50%;
            margin-right: 4px;
            vertical-align: middle;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background: #f7f8fc;
        }
        .msg { display: flex; gap: 10px; max-width: 85%; }
        .msg.user { align-self: flex-end; flex-direction: row-reverse; }
        .msg-avatar {
            width: 34px; height: 34px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            align-self: flex-end;
        }
        .msg.user .msg-avatar { order: 1; }
        .msg-content {
            background: white;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 14px;
            line-height: 1.6;
            color: #333;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            word-break: break-word;
        }
        .msg.user .msg-content {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border-bottom-right-radius: 4px;
        }
        .msg:not(.user) .msg-content {
            border-bottom-left-radius: 4px;
        }
        .msg.typing .msg-content {
            color: #999;
            font-style: italic;
        }

        .chat-input-area {
            padding: 14px 16px;
            background: white;
            border-top: 1px solid #e8ecf4;
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }
        .chat-input {
            flex: 1;
            border: 1.5px solid #e0e4f0;
            border-radius: 22px;
            padding: 10px 16px;
            font-size: 14px;
            outline: none;
            resize: none;
            font-family: inherit;
            max-height: 120px;
            transition: border-color 0.2s;
        }
        .chat-input:focus { border-color: #667eea; }
        .btn-send {
            width: 42px; height: 42px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            font-size: 18px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            transition: opacity 0.2s;
        }
        .btn-send:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-send:hover:not(:disabled) { opacity: 0.9; }

        /* ===== Right: Knowledge Base Management ===== */
        .kb-panel {
            width: 380px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: white;
            overflow: hidden;
        }
        .kb-header {
            padding: 14px 18px;
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .kb-header h2 { font-size: 15px; color: #333; }
        .btn-add {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 14px;
            font-size: 13px;
            cursor: pointer;
            display: <%= isAdmin ? "inline" : "none" %>;
        }
        .btn-add:hover { opacity: 0.9; }

        .kb-filters {
            padding: 10px 18px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .filter-tag {
            padding: 3px 10px;
            border-radius: 20px;
            border: 1px solid #e0e4f0;
            font-size: 12px;
            cursor: pointer;
            color: #666;
            background: white;
        }
        .filter-tag.active, .filter-tag:hover {
            background: #667eea22;
            border-color: #667eea;
            color: #667eea;
        }

        .kb-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px 0;
        }
        .kb-item {
            padding: 12px 18px;
            border-bottom: 1px solid #f5f5f5;
            cursor: pointer;
            transition: background 0.15s;
        }
        .kb-item:hover { background: #f7f8fc; }
        .kb-item.disabled { opacity: 0.45; }
        .kb-item-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 4px;
        }
        .kb-item-q {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-right: 8px;
        }
        .kb-item-cat {
            font-size: 11px;
            background: #667eea18;
            color: #667eea;
            padding: 1px 7px;
            border-radius: 10px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .kb-item-a {
            font-size: 12px;
            color: #888;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .kb-item-actions {
            display: none;
            margin-top: 6px;
            gap: 6px;
        }
        <%= isAdmin ? ".kb-item:hover .kb-item-actions { display: flex; }" : "" %>
        .btn-kb-edit, .btn-kb-del {
            font-size: 12px;
            padding: 2px 8px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
        }
        .btn-kb-edit { background: #e6f7ff; color: #1890ff; }
        .btn-kb-del { background: #fff1f0; color: #ff4d4f; }

        /* ===== Modal ===== */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.show { display: flex; }
        .modal {
            background: white;
            border-radius: 14px;
            padding: 28px;
            width: 480px;
            max-width: 90vw;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }
        .modal h3 { font-size: 17px; color: #333; margin-bottom: 18px; }
        .modal .field { margin-bottom: 14px; }
        .modal label { display: block; font-size: 13px; color: #666; margin-bottom: 5px; }
        .modal input, .modal select, .modal textarea {
            width: 100%;
            border: 1.5px solid #e0e4f0;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 13px;
            font-family: inherit;
            outline: none;
            box-sizing: border-box;
        }
        .modal input:focus, .modal select:focus, .modal textarea:focus {
            border-color: #667eea;
        }
        .modal textarea { resize: vertical; min-height: 80px; }
        .modal .actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px; }
        .modal .btn-cancel {
            padding: 8px 20px;
            border-radius: 8px;
            border: 1.5px solid #e0e4f0;
            background: white;
            color: #666;
            cursor: pointer;
            font-size: 14px;
        }
        .modal .btn-submit {
            padding: 8px 20px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            cursor: pointer;
            font-size: 14px;
        }

        /* ===== Scrollbar ===== */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #d0d5e8; border-radius: 3px; }

        /* ===== Back link ===== */
        .back-link {
            padding: 10px 20px;
            background: white;
            border-bottom: 1px solid #e8ecf4;
        }
        .back-link a { font-size: 13px; color: #667eea; text-decoration: none; }
        .back-link a:hover { text-decoration: underline; }
    
        /* Avatar mood overlay */
        .avatar-mood-wrap {
            position: relative;
            display: inline-block;
        }
        .avatar-mood-wrap .mood-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .avatar-mood-wrap .mood-overlay.active {
            opacity: 1;
        }

        .btn-clear-chat {
            background: none;
            border: none;
            font-size: 16px;
            cursor: pointer;
            opacity: 0.5;
            margin-left: auto;
            padding: 4px 8px;
        }
        .btn-clear-chat:hover { opacity: 1; }

        /* Import Modal Tabs */
        .import-tab {
            padding: 6px 16px;
            border: 1px solid #e0e4f0;
            background: white;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            color: #666;
        }
        .import-tab.active {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border-color: transparent;
        }
        .import-tab:hover:not(.active) {
            border-color: #667eea;
            color: #667eea;
        }

        /* ===== Character Selector ===== */
        .character-selector {
            padding: 10px 16px;
            background: white;
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            gap: 12px;
            overflow-x: auto;
            flex-shrink: 0;
        }
        .character-card {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 20px;
            border: 2px solid #e0e4f0;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
            flex-shrink: 0;
        }
        .character-card:hover {
            border-color: #667eea;
            background: #f7f8fc;
        }
        .character-card.active {
            border-color: #667eea;
            background: linear-gradient(135deg, #667eea15, #764ba215);
            box-shadow: 0 2px 8px rgba(102,126,234,0.2);
        }
        .character-card .char-avatar {
            width: 42px; height: 42px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid #e0e4f0;
        }
        .character-card.active .char-avatar {
            border-color: #667eea;
        }
        .character-card .char-name {
            font-size: 13px;
            font-weight: 600;
            color: #333;
        }
        .character-card .char-title {
            font-size: 11px;
            color: #999;
        }
        .character-card .char-info {
            display: flex;
            flex-direction: column;
        }

        /* ===== Unanswered Panel ===== */
        .unanswered-panel {
            padding: 12px 16px;
            border-bottom: 1px solid #e8ecf4;
            background: white;
        }
        .unanswered-panel h3 {
            font-size: 14px;
            color: #333;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .unanswered-panel .badge {
            background: #ff4d4f;
            color: white;
            font-size: 11px;
            padding: 1px 6px;
            border-radius: 10px;
        }
        .unanswered-item {
            padding: 8px 10px;
            border: 1px solid #f0f0f0;
            border-radius: 6px;
            margin-bottom: 6px;
            font-size: 12px;
        }
        .unanswered-item .uq-question {
            color: #333;
            margin-bottom: 4px;
        }
        .unanswered-item .uq-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .unanswered-item .uq-time { color: #999; font-size: 11px; }
        .unanswered-item .uq-actions { display: flex; gap: 4px; }
        .unanswered-item .btn-uq {
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
        }
        .btn-uq-answer { background: #e6f7ff; color: #1890ff; }
        .btn-uq-ignore { background: #f5f5f5; color: #999; }
        .btn-uq-answer:hover { background: #bae7ff; }
        .btn-uq-ignore:hover { background: #e8e8e8; }
        /* ===== Document Import Modal ===== */
        .doc-import-modal .upload-area {
            border: 2px dashed #d0d5e8;
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: #f7f8fc;
            margin-bottom: 16px;
        }
        .doc-import-modal .upload-area:hover,
        .doc-import-modal .upload-area.dragover {
            border-color: #667eea;
            background: #f0f2f8;
        }
        .doc-import-modal .upload-icon { font-size: 48px; margin-bottom: 12px; }
        .doc-import-modal .upload-text { font-size: 14px; color: #666; }
        .doc-import-modal .upload-hint { font-size: 12px; color: #999; margin-top: 6px; }
        .doc-import-modal .file-list { margin-top: 16px; text-align: left; }
        .doc-import-modal .file-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border: 1px solid #e8ecf4;
            border-radius: 8px;
            margin-bottom: 8px;
            font-size: 13px;
        }
        .doc-import-modal .file-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .doc-import-modal .file-size { color: #999; margin-left: 8px; }
        .doc-import-modal .file-remove {
            color: #ff4d4f;
            cursor: pointer;
            margin-left: 8px;
            font-size: 16px;
        }
        .doc-import-modal .progress-wrap { margin-top: 12px; display: none; }
        .doc-import-modal .progress-bar {
            height: 6px;
            background: #e8ecf4;
            border-radius: 3px;
            overflow: hidden;
        }
        .doc-import-modal .progress-fill {
            height: 100%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            width: 0%;
            transition: width 0.3s;
        }
        .doc-import-modal .progress-text { font-size: 12px; color: #999; margin-top: 4px; }
        .doc-import-modal .preview-area {
            margin-top: 16px;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #e8ecf4;
            border-radius: 8px;
            padding: 12px;
            background: #f7f8fc;
            display: none;
        }
        .doc-import-modal .preview-item {
            padding: 8px 10px;
            border-bottom: 1px solid #eee;
            font-size: 12px;
            color: #333;
        }
        .doc-import-modal .preview-item:last-child { border-bottom: none; }

    </style>
</head>
<body>

<div class="header">
    <h1>📚 知识库</h1>
    <div class="right">
        <span style="font-size:14px;opacity:0.9"><%= user.getNickname() %></span>
        <span class="divider">|</span>
        <a href="${pageContext.request.contextPath}/home.jsp">功能中心</a>
        <a href="${pageContext.request.contextPath}/dashboard.jsp">版本管理</a>
        <a href="${pageContext.request.contextPath}/logout">退出</a>
    
        <span class="divider">|</span>
        <a href="${pageContext.request.contextPath}/employee/employee-login.jsp" class="emp-login-link" id="empLoginLink">员工登录</a>
        <div class="emp-area" id="empArea" style="display:none" onclick="location.href='${pageContext.request.contextPath}/employee/portal'">
            <img class="emp-avatar" id="empHeaderAvatar" src="" alt="头像">
            <span class="emp-name" id="empHeaderName"></span>
        </div>

    </div>
</div>

<div class="main">

    <!-- ===== Left: Chat ===== -->
    <div class="chat-panel">
        <div class="chat-header">
            <div class="avatar-mood-wrap" style="width:48px;height:48px;border-radius:50%;overflow:hidden;position:relative;flex-shrink:0;background:transparent">
                <img src="${pageContext.request.contextPath}/images/avatar/avatar_base.jpg" class="bot-avatar" alt="avatar"
                     style="width:100%;height:100%;object-fit:cover;border-radius:50%">
                <!-- Mood overlay SVG files -->
                <img id="mood-thinking" class="mood-overlay" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_thinking.svg">
                <img id="mood-happy" class="mood-overlay" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_happy.svg">
                <img id="mood-neutral" class="mood-overlay active" src="${pageContext.request.contextPath}/images/avatar/avatar_photo_neutral.svg">
            </div>
            <div class="bot-info">
                <div class="bot-name">囚牛 AI 助手</div>
                <div class="bot-status">基于知识库回答</div>
            </div>
            <button class="btn-clear-chat" onclick="clearChat()" title="清空对话">🗑️</button>
        </div>

        <!-- Character Selector -->
        <div class="character-selector" id="characterSelector">
            <!-- 由 renderCharacterSelector() 动态渲染 -->
        </div>

        <div class="chat-messages" id="chatMessages">
            <div class="msg">
                <img src="${pageContext.request.contextPath}/images/avatar/avatar_base.jpg" class="msg-avatar" alt="bot">
                <div class="msg-content">👋 你好！我是囚牛 AI 助手，可以基于知识库回答你的问题。有什么想了解的？</div>
            </div>
        </div>

        <div class="chat-input-area">
            <textarea id="chatInput" class="chat-input" placeholder="输入问题，按 Enter 发送..." rows="1"
                      onkeydown="handleKeyDown(event)"></textarea>
            <button class="btn-send" id="btnSend" onclick="sendMessage()">➤</button>
        </div>
    </div>

    <!-- ===== Right: Knowledge Base ===== -->
    <div class="kb-panel">
        <div class="kb-header">
            <h2>📖 知识库条目</h2>
            <div>
                <% if (canWrite) { %>
                <button class="btn-add" style="margin-right:8px" onclick="openImportModal()">📂 导入</button>
                <button class="btn-add" style="margin-right:8px" onclick="openDocImportModal()">📄 文档导入</button>
                <button class="btn-add" onclick="openModal()">+ 新增</button>
                <% } %>
            </div>
        </div>
        <div class="kb-filters" id="kbFilters">
            <span class="filter-tag active" data-cat="">全部</span>
        </div>
        <div class="kb-list" id="kbList"></div>
    </div>

</div>

<!-- ===== Modal ===== -->
<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()">
    <div class="modal">
        <h3 id="modalTitle">新增知识条目</h3>
        <input type="hidden" id="editId">
        <div class="field">
            <label>问题关键词（多个用 | 分隔）</label>
            <input type="text" id="fQuestion" placeholder="如：项目介绍|什么是囚牛">
        </div>
        <div class="field">
            <label>回答内容</label>
            <textarea id="fAnswer" placeholder="输入标准回答..."></textarea>
        </div>
        <div class="field">
            <label>分类</label>
            <input type="text" id="fCategory" placeholder="如：项目介绍" list="catList">
            <datalist id="catList">
                <% if(categories != null) for(String c : categories) { %>
                <option value="<%= c %>">
                <% } %>
            </datalist>
        </div>
        <div class="actions">
            <button class="btn-cancel" onclick="closeModal()">取消</button>
            <button class="btn-submit" onclick="submitEntry()">保存</button>
        </div>
    </div>
</div>

<!-- ===== Import Modal ===== -->
<div class="modal-overlay" id="importModalOverlay" onclick="if(event.target===this)closeImportModal()">
    <div class="modal" style="width:520px">
        <h3>导入知识条目</h3>
        <div class="import-tabs" style="display:flex;gap:10px;margin-bottom:16px">
            <button class="import-tab active" onclick="setImportMode('json')" id="tabJson">粘贴 JSON</button>
            <button class="import-tab" onclick="setImportMode('file')" id="tabFile">上传文件</button>
        </div>
        <div id="importJsonArea">
            <div class="field">
                <label>JSON 格式（数组）</label>
